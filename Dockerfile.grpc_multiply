FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY matrix.proto .
COPY grpc_multiply_server.py .

# Generate gRPC code
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. matrix.proto

EXPOSE 50051

CMD ["python", "grpc_multiply_server.py", "--port", "50051"]
